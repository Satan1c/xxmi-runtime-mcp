+template <typename HashType>
+static void LogMcpHuntStep(const char *action, HashType hash)
+{
+	if (G->hunting != HUNTING_MODE_ENABLED)
+		return;
+
+	if (hash == (HashType)-1)
+		LogInfo("XXMI_MCP/1 hunt %s none\n", action);
+	else
+		LogInfo("XXMI_MCP/1 hunt %s %0*llx\n", action,
+			(int)(2 * sizeof(hash)), (unsigned long long)hash);
+}
