+static void LogMcpSelections()
+{
+	wchar_t snapshot[256];
+	swprintf_s(snapshot, L"vertexbuffer=%08x indexbuffer=%08x vertexshader=%016llx "
+		L"hullshader=%016llx domainshader=%016llx geometryshader=%016llx "
+		L"pixelshader=%016llx computeshader=%016llx rendertarget=%08x",
+		G->mSelectedVertexBuffer, G->mSelectedIndexBuffer, G->mSelectedVertexShader,
+		G->mSelectedHullShader, G->mSelectedDomainShader, G->mSelectedGeometryShader,
+		G->mSelectedPixelShader, G->mSelectedComputeShader,
+		G->mSelectedRenderTarget == (ID3D11Resource *)-1
+			? 0xffffffffu : GetOrigResourceHash(G->mSelectedRenderTarget));
+
+	static std::wstring previous;
+	if (previous != snapshot) {
+		LogInfoW(L"XXMI_MCP/1 selections %ls\n", snapshot);
+		previous = snapshot;
+	}
+}
